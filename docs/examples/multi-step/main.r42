model_provider "primary" {
  type        = "openai"
  endpoint    = "https://api.openai.com/v1"
  wire_api    = "responses"
  transport   = "http"
  api_key_ref = "OPENAI_API_KEY"

  retry {
    lifecycle_retries    = 10
    model_call_retries   = 5
    interval_seconds     = 10
    max_interval_seconds = 180
  }
}

research "architecture" {
  model_provider   = model_provider.primary
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are a software architecture researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the architecture and integration tradeoffs of adopting AI coding agents in a software engineering organization. Create ${cwd()}/research-output if needed and write your findings to ${cwd()}/research-output/architecture.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "${cwd()}/research-output/architecture.md"
    required  = true
    non_empty = true
  }
}

research "security" {
  model_provider   = model_provider.primary
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are an application security researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the security, privacy, and governance risks of adopting AI coding agents in a software engineering organization. Create ${cwd()}/research-output if needed and write your findings to ${cwd()}/research-output/security.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "${cwd()}/research-output/security.md"
    required  = true
    non_empty = true
  }
}

research "delivery" {
  model_provider   = model_provider.primary
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are an engineering effectiveness researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the delivery, quality, and organizational effects of adopting AI coding agents in a software engineering organization. Create ${cwd()}/research-output if needed and write your findings to ${cwd()}/research-output/delivery.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "${cwd()}/research-output/delivery.md"
    required  = true
    non_empty = true
  }
}

research "synthesis" {
  model_provider   = model_provider.primary
  model            = "gpt-5.6-sol"
  reasoning_effort = "high"
  system_prompt    = "You are the lead researcher. Reconcile disagreements, preserve source attribution, and produce a decision-oriented final report."
  prompt           = <<-PROMPT
    Read these three subreports from the shared output directory:

    - ${cwd()}/research-output/architecture.md
    - ${cwd()}/research-output/security.md
    - ${cwd()}/research-output/delivery.md

    Synthesize them into ${cwd()}/research-output/final_report.md. Include an executive
    summary, cross-cutting tradeoffs, unresolved uncertainties, and
    recommendations.
  PROMPT
  permission = "approve_all"
  depends_on = [
    research.architecture,
    research.security,
    research.delivery,
  ]

  artifact "final_report" {
    type      = "file"
    path      = "${cwd()}/research-output/final_report.md"
    required  = true
    non_empty = true
  }
}

output "final_report_path" {
  description = "Absolute path to the synthesized report."
  value       = research.synthesis.artifacts.final_report.path
}
