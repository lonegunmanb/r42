research "architecture" {
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are a software architecture researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the architecture and integration tradeoffs of adopting AI coding agents in a software engineering organization. Create ../../shared if needed and write your findings to ../../shared/architecture.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "../../shared/architecture.md"
    required  = true
    non_empty = true
  }
}

research "security" {
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are an application security researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the security, privacy, and governance risks of adopting AI coding agents in a software engineering organization. Create ../../shared if needed and write your findings to ../../shared/security.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "../../shared/security.md"
    required  = true
    non_empty = true
  }
}

research "delivery" {
  model            = "gpt-5.6-sol"
  reasoning_effort = "medium"
  system_prompt    = "You are an engineering effectiveness researcher. Use primary sources, separate evidence from inference, and write concise Markdown."
  prompt           = "Research the delivery, quality, and organizational effects of adopting AI coding agents in a software engineering organization. Create ../../shared if needed and write your findings to ../../shared/delivery.md."
  permission       = "approve_all"

  artifact "report" {
    type      = "file"
    path      = "../../shared/delivery.md"
    required  = true
    non_empty = true
  }
}

research "synthesis" {
  model            = "gpt-5.6-sol"
  reasoning_effort = "high"
  system_prompt    = "You are the lead researcher. Reconcile disagreements, preserve source attribution, and produce a decision-oriented final report."
  prompt           = <<-PROMPT
    Read these three subreports from the shared run directory:

    - ../../shared/architecture.md
    - ../../shared/security.md
    - ../../shared/delivery.md

    Synthesize them into ../../shared/final_report.md. Include an executive
    summary, cross-cutting tradeoffs, unresolved uncertainties, and
    recommendations.
  PROMPT
  permission = "approve_all"
  depends_on = [
    research.architecture,
    research.security,
    research.delivery,
  ]

  artifact "final_report" {
    type      = "file"
    path      = "../../shared/final_report.md"
    required  = true
    non_empty = true
  }
}

output "final_report_path" {
  description = "Absolute path to the synthesized report."
  value       = research.synthesis.artifacts.final_report.path
}
